{
  "name": "vlc-shortcuts-for-youtube",
  "version": "0.1.6",
  "type": "module",
  "description": "VLC's keyboard controls in YouTube's player",
  "imports": {
    "#imports": "./.wxt/types/imports-module.d.ts"
  },
  "author": "Avi <avi6106@gmail.com>",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/avi12/vlc-shortcuts-for-youtube",
  "homepage": "https://github.com/avi12/vlc-shortcuts-for-youtube",
  "scripts": {
    "dev": "bun run devtool dev",
    "dev:firefox": "bun run devtool dev --firefox",
    "dev:firefox:no-marionette": "bun run devtool dev --firefox --no-marionette",
    "dev:opera": "bun run devtool dev --opera",
    "devtool": "cargo run --release --quiet --manifest-path tools/Cargo.toml --",
    "dev-server:test": "cargo test --manifest-path dev-server/Cargo.toml",
    "tools:test": "cargo test --manifest-path tools/Cargo.toml",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:opera": "wxt build -b opera",
    "build:all": "bunx concurrently \"bun run build\" \"bun run build:firefox\" \"bun run build:opera\" --names \"Chrome ,Firefox,Opera  \"",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:opera": "wxt zip -b opera",
    "zip:all": "bunx concurrently \"bun run zip\" \"bun run zip:firefox\" \"bun run zip:opera\" --names \"Chrome ,Firefox,Opera  \"",
    "crx": "bun run zip && tsx scripts/pack-crx.ts",
    "lint": "tsx scripts/lint/lint.ts",
    "lint:fix": "tsx scripts/lint/oxlint.ts --fix && bun run stylelint",
    "stylelint": "stylelint \"src/**/*.css\" --fix --allow-empty-input",
    "typecheck": "tsrs --noEmit",
    "fallow": "fallow audit --base HEAD",
    "postinstall": "wxt prepare",
    "lint:oxlint": "tsx scripts/lint/oxlint.ts",
    "lint:stylelint": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:rust": "avi12-lint --only=rust",
    "prepare": "simple-git-hooks",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "crx3": "2.0.0",
    "fallow": "2.103.0",
    "fflate": "^0.8.3",
    "lint-config": "github:avi12/lint-config#v0.13.2",
    "oxfmt": "^0.80.0",
    "oxlint": "1.90.0",
    "postcss": "^8.5.30",
    "stylelint": "^17.14.0",
    "stylelint-config-ccb": "^3.32.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.2",
    "wxt": "^0.21.4",
    "tsrs": "7.1.0-beta.tsrs5",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0"
  },
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "esbuild",
    "spawn-sync",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "zod@4.6.7": "patches/zod.patch"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint-staged"
  }
}
