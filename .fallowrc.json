{
  "$schema": "./node_modules/fallow/schema.json",
  "extends": [
    "./node_modules/lint-config/packages/fallow-config/fallow.json"
  ],
  "entry": [
    "src/entrypoints/**",
    "tools/assets/*.mjs",
    "dev-server/assets/*.js",
    "web-ext.config.ts"
  ],
  "health": {
    "maxCognitive": 30,
    "maxCrap": 10000
  },
  "rules": {
    "unused-enum-members": "warn"
  }
}
