{
  "$schema": "./node_modules/fallow/schema.json",
  "extends": [
    "./node_modules/fallow-config-avi12/fallow.json"
  ],
  "ignoreDependencies": [
    "fallow-config-avi12",
    "oxlint-config-avi12",
    "oxlint-plugin-naming"
  ],
  "entry": [
    "src/entrypoints/**",
    "web-ext.config.ts"
  ],
  "health": {
    "maxCognitive": 30,
    "maxCrap": 10000
  },
  "rules": {
    "unused-enum-members": "warn"
  }
}
